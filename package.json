{
  "name": "saajha-captions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "models": "python3 scripts/fetch-model.py",
    "build": "node scripts/prepare.mjs && python3 scripts/source-archive.py && node node_modules/vite/bin/vite.js build && node scripts/service-worker.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": { "@huggingface/transformers": "4.3.2" },
  "devDependencies": { "@playwright/test": "1.61.1", "vite": "8.3.5" }
}
